# Absolute path to your Obsidian vault (created if missing)
OBSIDIAN_VAULT_PATH="C:\Users\you\path\to\univault"

# USDA FoodData Central API key (nutrition search + macro autofill)
# Free signup: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=""

# Garmin Connect credentials (fitness/sleep/wellness sync).
# Unofficial API — session tokens are cached in .garmin/ after first login.
# Note: accounts with MFA enabled are not supported by the sync.
GARMIN_EMAIL=""
GARMIN_PASSWORD=""

# Anthropic API key (Phase 3 assistant — unused for now)
ANTHROPIC_API_KEY=""
