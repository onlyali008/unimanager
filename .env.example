# Absolute path to your Obsidian vault (created if missing)
OBSIDIAN_VAULT_PATH="C:\Users\you\path\to\univault"

# USDA FoodData Central API key (nutrition search + macro autofill)
# Free signup: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=""

# Garmin Connect credentials (fitness/sleep/wellness sync).
# Unofficial API — session tokens are cached in .garmin/ after first login.
# Note: accounts with MFA enabled are not supported by the sync.
GARMIN_EMAIL=""
GARMIN_PASSWORD=""

# ─── Assistant chat models ───────────────────────────────────────────────────
# The Assistant page lets you pick a model per message. Set a key for any
# provider you want to use; only configured providers appear enabled in the
# picker. Models/base-URLs are defined in src/lib/ai/providers.ts (editable).
# NOTE: these power the chat only — nightly tagging, embeddings, weekly
# insights, and knowledge ingestion stay LOCAL on Ollama regardless.
ANTHROPIC_API_KEY=""      # Anthropic · Claude
OPENAI_API_KEY=""         # OpenAI · GPT / o-series
MOONSHOT_API_KEY=""       # Moonshot · Kimi
DASHSCOPE_API_KEY=""      # Alibaba · Qwen
DEEPSEEK_API_KEY=""       # DeepSeek
GEMINI_API_KEY=""         # Google · Gemini
XAI_API_KEY=""            # xAI · Grok
GROQ_API_KEY=""           # Groq (fast inference)
OPENROUTER_API_KEY=""     # OpenRouter (gateway to many models)
# Local Ollama chat needs no key (uses OLLAMA_URL below).

# Optional: override the default Anthropic model (default claude-opus-4-8)
# ANTHROPIC_MODEL="claude-opus-4-8"

# Local AI (nightly tagging/embeddings + weekly insights)
# Defaults shown; only set these to override.
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2:3b"
# OLLAMA_EMBED_MODEL="nomic-embed-text"

# Login (required before exposing the app beyond localhost — see
# docs/remote-access.md). Generate the hash + secret with:
#   node scripts/set-password.mjs "your-password"
# All three set => every page/API requires sign-in.
AUTH_EMAIL=""
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""

# Email verification codes at login (optional; password-only without it)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
